# ---- Build artifacts (regenerated by emcmake/ninja/cargo/emscripten) ----
build-wasm/
source-ja2/build*/
**/target/
**/__pycache__/

# ---- Commercial JA2 game data - NOT distributable (copyright) ----
# Only the engine source was ever released; the Data/*.slf archives are commercial.
gamedata-src/
gamedata-lean/
fsroot/gamedata/
# Belt-and-suspenders: never commit any .slf archive (except the empty test fixtures).
*.slf
!source-ja2/rust/stracciatella/src/vfs/test_fixtures/empty.slf
!source-ja2/assets/unittests/data/empty.slf

# ---- Generated web data packages & wasm outputs (huge; rebuilt by the build) ----
play/ja2.js
play/ja2.wasm
play/ja2.data
play/ja2-gamedata.*
play/ja2-lean.*
*.br

# ---- Spike / smoke-test build trees (large, regenerable) ----
wasm-build/smoke/
wasm-build/smoke2/
wasm-build/fltk-release-1.4.3/
wasm-build/fltk.tar.gz

# ---- Secrets / local config ----
.env
play/.env
*.log

# ---- OS cruft ----
.DS_Store

# Prebuilt DESKTOP SDL2 binaries (Windows/Mac/VC) - unused by the wasm build,
# which uses Emscripten's SDL2 port. ~108M of dead weight; get them from upstream
# stracciatella if you ever need a native desktop build.
source-ja2/dependencies/lib-SDL2-2.0.20-mingw/
source-ja2/dependencies/lib-SDL2-2.0.20-VC/
source-ja2/dependencies/lib-SDL2-2.0.20-macos/

# Bulky example/community mods - not needed to run the port (the mod system is
# demonstrated by the small mods kept in fsroot/mods/). Restore from upstream
# stracciatella if wanted.
source-ja2/assets/mods/
fsroot/mods/simplified-chinese-localization/
fsroot/mods/o-fortuna/
play/testdata

# Terraform: state can contain sensitive values; provider plugins + lockfile are
# machine-local. Never commit these - infra is applied manually (see infra/terraform/README.md).
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/.terraform.lock.hcl

# Jenkins test-pipeline infra values (hosts/keys) - never commit
ci/jenkins/config.env

# Cloud Locker backend: installed deps (npm ci restores them) + filled secrets file.
cloud/node_modules/
cloud/.env
