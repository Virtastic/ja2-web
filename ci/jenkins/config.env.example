# Copy to ci/jenkins/config.env and fill in for YOUR infrastructure. That file is gitignored:
# this repo is public, so no host, user or key path belongs in git.
#
#   cp ci/jenkins/config.env.example ci/jenkins/config.env && $EDITOR ci/jenkins/config.env
#
# Every value can also be supplied as an environment variable (what a CI job should do).
# Precedence: environment > config.env > the placeholder defaults (which fail loudly).

# --- build server -------------------------------------------------------------------------
# Anything ssh(1) can reach: a Host alias from ~/.ssh/config, or user@host. Jenkins + Docker.
BUILDER="builder.example"
# Path on the build server holding the synced working tree.
DEST="ja2-src"

# --- test/app server ----------------------------------------------------------------------
# Where deploy-test.sh ships the image. user@host or an ssh alias.
TEST_HOST="deploy@app.example"
# Key the caller uses to reach the test server (Jenkins: /var/jenkins_home/.ssh/id_ed25519;
# by hand: your own key).
SSH_KEY="$HOME/.ssh/id_ed25519"
# Published host port for the ja2-test container (its nginx listens on :80 inside). The
# nginx-proxy-manager in front routes ja2.dev.virtastic.app -> TEST_HOST:PORT.
PORT="8081"

# --- the deployed origin ------------------------------------------------------------------
# Public URL the smoke test runs against after deploy (TLS + the launcher gate only exist at
# the real origin). Empty skips the public smoke and checks the container directly instead.
SMOKE_URL="https://ja2.dev.virtastic.app"
