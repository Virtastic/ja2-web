# ja2-cloud config. Copy to the VPS as /opt/ja2/cloud.env (referenced by docker-compose.prod.yml's
# env_file). NEVER commit the filled-in version — it holds OAuth secrets and S3 keys.

# Public origin the browser hits. OAuth redirect URIs are derived as
# <BASE_URL>/api/auth/<provider>/callback — register EXACTLY that at each provider.
BASE_URL=https://ja2.virtastic.app

# Session signing key (HS256). Generate: openssl rand -hex 32
JWT_SECRET=

# --- Storage. TWO modes:
#   Local (default): leave S3_* blank. Game data + saves persist to DATA_DIR (the /data volume in
#     compose) and the backend serves them itself. No object store, no CORS - just a disk. Simplest.
#   S3: fill S3_* below. The browser transfers DIRECTLY to S3 via presigned URLs (game data never
#     proxies through the backend). The bucket needs CORS allowing BASE_URL for GET/PUT/DELETE.
DATA_DIR=/data
S3_ENDPOINT=
S3_REGION=gra
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=1   # set for MinIO / path-style endpoints

# --- OAuth apps (register each; only the ones you fill in show as live in the launcher).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# DEV_AUTH=1   # dev/test ONLY: enables /api/auth/dev/login (no real OAuth). Never in prod.
