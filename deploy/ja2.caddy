# Edge vhost for ja2.virtastic.app - deployed as a drop-in into the shared edge Caddy's sites dir
# (on the VPS: /opt/edge/sites/ja2.caddy; imported by /opt/edge/Caddyfile via `import sites/*.caddy`).
# The shared edge terminates TLS with the *.virtastic.app Cloudflare Origin cert (same wildcard cert
# that already fronts morrowind) and reverse-proxies to the ja2 container by name on the shared net.
#
# The container's own nginx already sets COOP/COEP/CORP (required for SharedArrayBuffer/pthreads);
# those response headers pass through this reverse_proxy. So this vhost deliberately does NOT set
# them again (duplicate COOP/COEP breaks crossOriginIsolated) and does NOT `encode` (Cloudflare
# compresses the raw wasm/data at the edge). No `import inject` - greenfield, no origin guard.
# /api/* is the same-origin Cloud Locker backend (ja2-cloud); everything else is the static game
# (ja2). Same-origin keeps the session cookie clean (no CORS to our own API) and lets the browser
# transfer game data + saves directly to S3 via presigned URLs the backend mints. The API path
# carries no COOP/COEP (JSON/redirects, not embedded) - ja2-cloud sets none and neither does this.
ja2.virtastic.app {
	tls /certs/virtastic.crt /certs/virtastic.key
	# virtastic.app runs ja2 inside its Virtastic Navigator window (an iframe), so this vhost lets
	# that one site frame it: sec_headers' X-Frame-Options SAMEORIGIN goes, and frame-ancestors
	# allows virtastic.app (and www) only, so no other site can frame the sign-in. The delete sits
	# BEFORE the import: deferred header ops run innermost first, so the outermost (this) runs last
	# and wins - the same ordering freecad.caddy needed (measured there).
	header -X-Frame-Options
	header Content-Security-Policy "frame-ancestors 'self' https://virtastic.app https://www.virtastic.app"
	import sec_headers
	handle /api/* {
		reverse_proxy ja2-cloud:8080
	}
	handle {
		reverse_proxy ja2:80
	}
}
